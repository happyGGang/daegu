<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.go.gbelib.app.cms.module.conversionExample.ConversionExampleDao">


  <select id="commonList" resultType="java.util.HashMap" parameterType="int" >
    ${pagingTop}
    SELECT
        conversion_idx, conversion_name, conversion_content
    FROM
        CONVERSION_EXAMPLE
    WHERE 1=1
      AND conversion_idx = #{conversion_idx}
      <if test="search_type != null and search_type != '' and search_text != null and search_text != ''">
        AND ${search_type} LIKE '%'||#{search_text}||'%'
      </if>
    ${pagingBottom}
  </select>

  <select id="totalCount"  resultType="int" >
    SELECT
        COUNT(*)
    FROM
        CONVERSION_EXAMPLE
  </select>

  <select id="totalTestCount" resultType="int" parameterType="int" >
    SELECT
        COUNT(*)
    FROM
        CONVERSION_EXAMPLE
  </select>
</mapper>