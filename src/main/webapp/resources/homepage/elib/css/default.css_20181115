@charset "utf-8";

/* 스타일 */
body,div,dl,dt,dd,ul,ol,li,h1,h2,h3,h4,h5,h6,pre,code,form,fieldset,legend,input,button,textarea,p,blockquote,th,td,address
{font-size:13px}

a:hover,
a:focus{color:#2b74c0}

/* header */
.tnb{overflow:hidden}
.tnb h1,
.tnb .util{float:left}
.tnb .util{float:right}

#header h1{font-size:0;line-height:0;padding:23px 0 10px;margin:25px 0 20px}
.popupWrap{z-index:6}

/* header */
.tnb{overflow:hidden}
.tnb h1{width:100%;text-align:center}
.tnb .util{position:absolute;top:0;left:0;width:100%;height:20px;padding-top:20px;text-align:right}
.tnb .util a{color:#2d2d2d;font-size:11px;margin-left:11px;font-weight:bold}

/* Gnb */
.mmenu{width:100%;height:65px;overflow:inherit;position:relative;background:#2f4c93;z-index:100000}

/* Gnb */
.Gnb{clear:both;text-align:center;width:100%;height:63px;overflow:inherit;position:relative;z-index:1!important;text-align:left;}
.Gnb .gnb-menu{position:relative;height:63px;}
.Gnb .gnb-menu > li{padding:0 2%;text-align:center;position:static}
.Gnb .gnb-menu > li > a{padding:0 5px;line-height:67px;height:54px;font-size:18px;font-weight:bold;color:#fff}
.Gnb .gnb-menu > li > ul{display:none;position:absolute;width:100%;margin-top:11px;background:#666;border:0;white-space:nowrap;text-align:center;}
.Gnb .gnb-menu > li.active > ul{display:block}
.Gnb .gnb-menu > li > .SubMenu >li{width:auto;padding:0 5px}
.Gnb .gnb-menu > li > .SubMenu >li{display:inline-block;zoom:1;*display:inline}
.Gnb .gnb-menu > li > .SubMenu >li > a{font-size:13px;padding:0 5px}
.Gnb .gnb-menu > li > .SubMenu >li > a:hover,
.Gnb .gnb-menu > li > .SubMenu >li > a:focus{background:none;color:#1f5d98}
.Gnb .gnb-menu > li.on > a, .Gnb .gnb-menu > li > a:hover, .Gnb .gnb-menu > li > a:focus{color:#f8b62c}
.Gnb .gnb-menu > li.ss > a{font-size:14px}
.Gnb .mask{width:100%}
.Gnb .mask, .Gnb .gnb-menu > li > ul{background:#e5e5e5;height:40px;line-height:40px}
.Gnb .gnb-menu > li > ul{left:0}


/*
.mmenu .menu{position:relative;padding:0;margin:0;width:100%;}
.mmenu .menu>li{float:left;width:50%;text-align:center;position:static;height:65px;background:#2f4c93}
.mmenu .menu>li.m3{background:#f8b62c}
.mmenu .menu>li>a{display:block;padding-top:23px;font-size:18px;color:#fff;font-weight:bold;width:100%;height:42px}
.mmenu .menu>li.active>a,
.mmenu .menu>li>a:hover,
.mmenu .menu>li>a:focus{background:url('http://www.gbelib.kr/resources/homepage/elib/img/mmenu_bg.png') repeat}
*/

#header .search-box{position:absolute;top:119px;right:0;border:0;border-radius:0;padding:0;background:#f8b62c;height:65px;margin:0;z-index:100000}
#header .search-box{width:45%}
#header .search-box fieldset{position:relative;zoom:1;border:0px solid #fff;padding:12px 0 0 25px;overflow:hidden;border-radius:3px;width:353px}
#header .search-box input{border:0;background:#fff;width:93%;padding-left:20px}
/*#header .search-box input:focus{outline:none}
#header .search-box input,
#header .search-box button{height:40px;line-height:40px}
#header .search-box button{float:right;width:26%;text-align:center;color:#fff;margin-right:0px;border:1px solid #fff;border-radius:3px;background:#423e37}
#header .search-box .box1{float:left;width:97%;margin-right:-25%}
#header .search-box .box2{margin-right:25%}
*/

.search-box .box{border:0;border-radius:3px;background:#fff;overflow:hidden;position:relative;height: auto;}
.search-box .b1{padding:0 10px}
.search-box .b2{position:absolute;top:0;right:0;width:10%;height: 100%;}
.search-box button{background:#fff;border:0;color:#000;font-size:20px;text-align:center;height: 100%!important;}
.search-box button{width:100%}
.search-box button, .search-box input, .search-box select, .search-box .select2-container .select2-selection--single, .search-box .select2-container--default .select2-selection--single .select2-selection__arrow, .search-box .select2-container--default .select2-selection--single .select2-selection__rendered{height:40px;line-height:40px}
.search-box select, .search-box .select2-container .select2-selection--single, .search-box .select2-container--default .select2-selection--single .select2-selection__arrow, .search-box .select2-container--default .select2-selection--single .select2-selection__rendered{height:40px;line-height:40px}
.search-box .select2-container--default .select2-selection--single .select2-selection__rendered{padding-left:10px}
.search-box .select2-container--default .select2-selection--single .select2-selection__arrow{padding-right:3px}
.search-box .box1 .select2-container{border:1px solid #bbb;border-radius:5px;overflow:hidden}
.search-box .b1 .inputbox {display: inline-block;float: left; min-width: 60%; overflow: hidden;max-width: 70%;}
.search-box .b1 .checkbox { float: right; display: inline-block; width: 144px; margin-right: 50px; height: 40px;}

#container.subpage > .section{}

.main{background:url('http://www.gbelib.kr/resources/homepage/elib/img/main_bg.gif') repeat-x;z-index:2!important;margin-top:-55px}
.main1{position:absolute;width:30%;height:200px;padding-top:150px;z-index:1!important}
.main1 .bx-wrapper,
.main1 .bx-viewport,
.main1 .bx-controls,
.main1 ul,
.main1 li{width:100%;height:100%;overflow:hidden;letter-spacing:-2px}
.main1 li .t01{font-size:350%;color:#2d2d2d;line-height:120%}
.main1 li .t02{font-size:180%;color:#3c3b3b;line-height:180%;letter-spacing:-1px}
.main1 li{position:relative}
.main1 .bx-pager{display:block!important;position:absolute;left:0;bottom:0}
.main1 .bx-pager .bx-pager-item{display:inline-block;zoom:1;*display:inline;font-size:0;line-height:0;padding:0 3px 0 2px}
.main1 .bx-pager a{display:block;border-radius:50%;width:9px;height:8px;background:#bea98d}
.main1 .bx-pager a:hover,
.main1 .bx-pager a:focus{background:#8e724d}
.main1 .bx-pager a.active{width:83px;height:8px;border-radius:5px;background:#bea98d}
.main1 .bx-controls .bx-prev,
.main1 .bx-controls .bx-next{top:0;font-size:0;line-height:0;margin-top:-56px;width:56px;height:111px;position:absolute;background:url('../img/type11/slider_btn.png') no-repeat 0 0}
.main1 .bx-controls .bx-prev{left:3%}
.main1 .bx-controls .bx-next{right:3%;background-position:-56px 0}
.main1 .bx-controls .bx-prev:focus,
.main1 .bx-controls .bx-prev:hover{background-position:0 -111px}
.main1 .bx-controls .bx-next:focus,
.main1 .bx-controls .bx-next:hover{background-position:-56px -111px}
.main1 .bx-viewport{position:relative;z-index:10}
.main1 .bx-controls{position:absolute;z-index:11;top:0}
.main .mimg{float:right;position:relative;width:50%;height:465px;background:url('http://www.gbelib.kr/resources/homepage/elib/img/main_img.png') no-repeat center center}

.main .mbanner{float:left;position:relative;width:20%;margin-top:50px;height:365px;margin-left:30%;z-index:5}
.main .mbanner{overflow:hidden;position:relative}
.main .mbanner>div{background:#ff5959}
.main .mbanner>div:first-child{background:#0ba39b}
.main .mbanner>div.bt3{background:#7f308e}
.main .banner-list{position:relative;width:50%;margin-right:50%;height:86px;padding-top:35px;text-align:center}
.main .banner-list:first-child{margin-left:50%}
.main .banner-list.bt3{margin-left:50%}
.main .banner-list a{transition:all .25s ease;display:block;width:100%;height:0;position:absolute;bottom:0;left:0;z-index:100;background:url('/resources/homepage/elib/img/mbanner_bg.png') repeat}
.main .banner-list h3{font-size:15px;margin-bottom:5px;color:#fff}
.main .banner-list p{font-size:20px;line-height:22px;font-weight:bold;color:#fff}
.main .banner-list h3:before{position:absolute;top:50%;right:2%;margin-top:-38px;content:"";display:block;width:79px;height:77px}
.main .banner-list h4{display:none}
.main .banner-list a:before{position:absolute;bottom:13px;left:50%;margin-left:-18px;content:"";display:none;background:url('/resources/homepage/elib/img/subsite_sprite.png') no-repeat 13px 7px;border:1px solid #fff;border-radius:50%}
.main .banner-list:hover a{width:100%;height:100%}
.main .banner-list:hover h4{display:block;position:absolute;top:20px;left:0;width:100%;z-index:300;color:#fff;text-align:center;font-weight:bold}
.main .banner-list:hover h4:before{display:none}
.main .banner-list:hover h3,
.main .banner-list:hover p{display:none}
.main .banner-list:hover a:before{width:35px;height:34px;display:block}
.main .banner-list:hover a:hover:before{transform:rotate(360deg);transition:all 0.5s ease-in-out 0s}
.main .bestbook,
.main .like_book{position:relative;height:auto;clear:both}
.main .bestbook h3,
.main .like_book h3{border-bottom:1px solid #dedede;padding:20px 10px 10px;color:#f43b40;font-size:18px;font-weight:bold;z-index:1000}
.main .bestbook_m{float:left;width:49%;margin:2%;position:relative}
.main .bestbook_m li{overflow:hidden;padding:30px 0;padding-right:1px}
.main .bestbook_m li em{position:absolute;top:20px;left:-17px}
.main .bestbook_m .item{font-size:120%}
.main .bestbook_m .item strong.sbj{font-size:140%;color:#000}
.main .bestbook_m .thumb{float:left;width:26.5%;margin-right:3%;line-height:0}
.main .bestbook_m .thumb img{width:150px;border:1px solid #dedede}
.main .bestbook_m .item{float:left;width:100%;margin-right:-33%}
.main .bestbook_m .item a.box{margin-right:20%;padding-left:2%}
.main .bestbook_m .item p{padding:10px 0 0;color:#666;padding-left:2%;width:68%;letter-spacing:-1px}
.main .bestbook_m .item p.snipet{line-height:160%;font-size:14px;text-align: justify}
.main .bestbook_l{float:left;width:46%;margin:2% 0;position:relative}
.main .bestbook_l li{float:left;width:28.3%;height:150px;margin:13px 0;margin-left:5%}
.main .bestbook_l li .num{display:block;float:left;width:20%;height:30px;margin:0 5% 0 0;background:#4f5f9f;text-align:center;color:#fff;font-size:18px;font-weight:bold;line-height:30px}
.main .bestbook_l li .book{display:block;float:left;width:75%;height:100%;line-height:0}
.main .bestbook_l li .book img{width:130px;height:100%;border:1px solid #dedede}
.main .like_book .box{margin:20px 0 70px}
.main .like_book .bx-viewport{height:auto!important}
.main .like_book .bx-wrapper{width:auto!important;padding:0 30px!important;position:relative}
.main .like_book li{text-align:center;color:#2d2d2d;line-height:19px}
.main .like_book li a{display:block;text-align:center;margin:10px 0 0}
.main .like_book li img{border:1px solid #dedede;width:150px;height:210px}
.main .like_book li span{display:block;font-size:14px;;margin-top:15px;font-weight:bold}
.main .like_book li em{display:block;font-style:normal;font-size:13px;margin-top:15px}
.main .like_book .bx-pager{display:none}
.main .like_book .bx-prev,
.main .like_book .bx-next{top:0;font-size:0;line-height:0;position:absolute;height:98%;width:30px;background:#fff url('../img/bookbtl.gif') no-repeat 0 99px}
.main .like_book .bx-prev{left:0}
.main .like_book .bx-next{right:0;background-image:url('../img/bookbtr.gif');background-position:right 99px}

.main .bbanner{float:left;position:relative;width:20%;margin-top:12px}
.main .bbanner a{display:block;width:100%;text-align:center;color:#fff;border-radius:5px;margin-bottom:7px;height:40px;line-height:40px;font-size:15px;letter-spacing:-1px;font-weight:bold}
.main .mb1 a{background:#4847c0}
.main .mb1 a:hover{background:#191888}
.main .mb2 a{background:#52c3d2}
.main .mb2 a:hover{background:#26a2b2}
.main .mb3 a{background:#ff5959}
.main .mb3 a:hover{background:#e53030}
.main .mb4 a{background:#70b5d6;margin-bottom:0}
.main .mb4 a:hover{background:#5197b9}

.main .news{width:35%;margin-left:5%;float:left;position:relative}
.main .news h3{width:100%;border-bottom:1px solid #dedede;padding-bottom:13px;color:#000;font-size:18px;font-weight:bold}
.main .news .more{right:0;top:8px;font-size:0;line-height:0;position:absolute;background:url('../img/more_bt.gif') no-repeat 0 0;width:32px;height:32px}
.main .news li{padding:3px 75px 3px 10px}
.main .news ul{padding-top:10px}
.main .news em,
.main .news span{color:#2d2d2d;font-size:13px!important}

.elib_cate .bestbook_l_table{margin:2% 0;}
.elib_cate table, .elib_cate .bestbook_l_table td {border: 0px;}
.elib_cate .bestbook_l_table .num{display:block;float:left;width:30px;height:30px;margin:0 5% 0 0;background:#4f5f9f;text-align:center;color:#fff;font-size:18px;font-weight:bold;line-height:30px}
.elib_cate .bestbook_l_table .book{display:block;float:left;width:75%;height:100%;line-height:0}
.elib_cate .bestbook_l_table .book img{width:109px;float:left;height:100%;border:1px solid #dedede}


.lnb{width:250px;float:left}
.content{margin-right:-250px;width:100%;float:left}
.doc{margin-right:250px}
.lnb > h2{background:url('../img/sub_lng_bg.gif') no-repeat 0 0;color:#fff;font-size:18px;font-weight:bold;}
.lnb > h2 > b {margin-right:0;text-align:center;padding:80px 0 60px 0}
.lnb h2 span{position:relative;display:block;font-size:24px;padding:0;display:block;margin-right:30%;}
.lnb h2 span i{font-style:normal;position:absolute;width:210px;text-align:center}
.lnb > ul > li > a {text-align:Center;color:#2f4c93;border-bottom:1px solid #2f4c93}
.lnb > ul > li > a:hover {color:#f05156;border-bottom:1px solid #f05156}
.lnb > ul > li > ul > li > a {border-bottom:1px solid #d9d9d9}
.lnb ul li.active > a{background:#fff;color:#f05156;position:relative;border-bottom:1px solid #f05156}
.lnb ul li.active > a:hover{color:#f05156}
.lnb ul ul li.active > a{color:#3975d6}


/* 본문 */
.doc-title h3{font-size:20px}
.doc-info{margin-top:15px;width:78%;}
.doc-info ol li{font-size:13px;padding-left:22px;margin-left:0px;background:url('../img/doc-infoLo.gif') no-repeat 5px 13px}
.doc-info ol li.on a{color:#206ff6;font-weight:bold}

/* 접속기록안내 */
#memberInfo{position:absolute;width:22%;left:98%;top:18%;background:#fff;margin-left:-35%;box-shadow:0px 1px 7px 0px rgba(0,0,0,0.5);z-index: 9;}
#memberInfo .inbox{position:relative;border:1px solid #ccc;padding:10px;}
#memberInfo .inbox dt{font-weight:bold;font-family:verdana;padding-bottom: 10px;}
#memberInfo .inbox dd{padding:3px 0}
a#closeMemberInfo{position:absolute;right:7px;top:5px;font-size:120%}
#line{width: 160px;}
div.loginInfo{padding-top: 8px;padding-bottom: 15px;}
span.fontRed{color: red;}
span.fontBlue{color: rgb(27,104,199);font-weight: bold;}
div.memberCon{background-color: rgb(240,240,240);border-radius: 1em;}
div.memberCon2{padding-top: 12px;padding-left: 10px;padding-right: 10px; padding-bottom: 28px;}
a.btnStyle{float: right;margin-top: 6px;}
#loginIcon{padding-top: 13px;padding-left:10px;}
.boxnImg{ float: left; }
.box2_1 { float: left; width: 34%; }
.box3_1 { float: left; width: 38%; border-left: 1px solid #ddd; }
.boxn { padding-top: 1%; padding-bottom: 1%; padding-left: 5%; }


span.txt-bar{padding:1px 0;background:#ccc;vertical-align:middle}

#footer{padding:55px 0 50px;position:relative;z-index:8}
#footer .section{position:relative;padding:0}
#footer .section .site_link{width:19.6%;display:inline-block;background:url('../img/footer_line.gif') repeat-y}
#footer .section .site_link div div{width:100%;border:0}
#footer .section .site_link ul a{width:90%!important;text-align:left;padding:3px 5%!important}
#footer .section .site_link a,
#footer .section .site_link span{display:block;border-radius:0;width:88%;line-height:45px!important;height:45px!important;background:none}
#footer .section .site_link ul a{line-height:30px!important;height:30px!important}
#footer .section .site_link span:hover{color:#d4d6da}
#footer .site_link > div > div > a.fsite{border:0}
#footer .site_link > div > div > a > span > i{border:0;width:14px;height:8px;right:25px;top:20px;background:url('../img/footer_more01.png') no-repeat 0 0}
#footer .site_link > div > div > a.active > span > i{border:0;background:url('../img/footer_more01on.png') no-repeat}
#footer .site_link > div > div > ul{bottom:45px;border:1px solid #ccc;background:#fff;border-width:1px 1px 0}
#footer .site_link > div > div > ul > li{border:0}
#footer .info{position:relative;height:45px;background:#585e69}
#footer .info .section{background:url('../img/footer_line.gif') repeat-y right 0}
#footer .info a{display:inline-block;position:relative;width:19.6%;line-height:45px;background:url('../img/footer_line.gif') repeat-y}
#footer .info a:hover{color:#d4d6da}
#footer .info a .more{font-size:0;line-height:0;right:20px;top:15px;position:absolute;background:url('../img/footer_more.png') no-repeat;width:14px;height:14px}
#footer .info a,
#footer .info span{vertical-align:middle;color:#fff;font-weight:bold;text-align:center}
#footer address{text-align:center;padding-top:30px}
#footer address em,
#footer address span{font-size:13px}
#footer address em{font-style:normal;margin-right:10px}
#footer address span{font-size:13px}

@media all and (max-width:1280px){
	.Gnb .gnb-menu > li{padding:0 1.4%}
}

@media all and (max-width:1141px){
	#header .search-box fieldset{width:96%;padding:12px 2%}
	#header .search-box input{width:95%;padding-left:20px}
	#header .search-box button{width:24%}
	.mmenu .menu{position:relative;padding:0;margin:0;width:80%;float:right}
}
@media all and (max-width:1024px){
	#header .search-box{top:65px;}
	.main{background:none;margin-top:0}
	.tnb .section{position:relative}
	.main .qmenu .bx-controls{display:block}
	#header h1{position:relative;height:auto;padding:7px 0 0 0;margin:0;width:250px}
	.m-menu{float:right}
	.m-menu a{display:inline-block;zoom:1;*display:inline;text-align:center;vertical-align:middle}
	.m-menu a i{font-size:30px;width:45px;height:45px;line-height:45px}
	.subpage .section{padding:0 3%}
	.tnb{padding:10px 0}
	.tnb .util,
	.Gnb{display:none}
	.mmode{display:block}
	.mmenu .menu, .mmenu, .search{width:100%}
	#header .search-box{width:96%;padding:12px 2%;}
	#header .search-box fieldset{width:96%;padding:12px 2%}
	#header .search-box input{width:96%;padding-left:20px}
	#header .search-box button{width:24%}
	.main .mimg{float:right;width:60%;height:398px;background:url('http://www.gbelib.kr/resources/homepage/elib/img/main_img.png') no-repeat center bottom;margin-top:-520px;background-size:98%}
	/*.main1{position:absolute;width:100%;height:200px;top:50px;left:4%;padding:0}*/
	.main1{display:none}
	.main .mbanner{width:100%;margin-top:342px;height:121px;margin-left:0}
	.main .banner-list{float:left;width:33.3%;margin-right:0}
	.main .banner-list:first-child{margin-left:0}
	.main .banner-list:last-child{margin-left:0}
	.main .banner-list a{width:100%;height:100%;background:none}
	.main .bestbook{padding:2% 0 0 0}
	.main .bestbook_m{width:94%;margin:3%}
	.main .bestbook_m .thumb{width:20%}
	.main .bestbook_l{width:96%;margin:0}
	.main .bbanner{width:100%;margin:0 0 30px}
	.main .bbanner a{float:left;width:23.3%;margin-right:1%}
	.main .news{width:44%;margin:0 3%}
	
	#footer .section{margin:0}
	#footer .section .site_link{width:18%!important;border:0}
	#footer .section .site_link div div{width:100%!important;border:0}
	#footer .info a .more{display:none}
	
	.doc{margin-right:0;padding:30px 0;overflow:hidden}
	.doc-head{width:160px;float:left;background:url('../img/h2-bg.gif') repeat-x 0 0}
	.doc-head h3{border-top:3px solid #1f5d97;padding-right:10%}
	.doc-body{margin-right:-160px;float:left;width:100%}
	.doc-body .body{margin-right:160px;margin-left:30px}
}
@media all and (max-width:767px){	
	#footer .info{display:none}
	#footer{margin-top:20px;padding:0px 0 10px;border-top:1px solid #ccc}
	
	#header .search-box input{width:93%;padding-left:20px}
	
	.doc-head{width:100%;float:none}
	.doc-head h3{text-align:left;border-top:3px solid #1f5d97;padding-left:0;padding-right:40%}
	.doc-body,
	.doc-body .body{float:none;margin:0}
}
@media all and (max-width:640px){
	.main .bbanner a{float:left;width:94%;margin:10px 3% 0}
	.main .news{width:94%;margin:20px 3%}
	.main .bestbook_l li{width:45%}
}
@media all and (max-width:400px){
	.main .mimg{float:right;width:70%;height:398px;background:url('/resources/homepage/elib/img/main_img.png') no-repeat center bottom;margin-top:-800px;background-size:98%}
	.main .mbanner{height:auto}
